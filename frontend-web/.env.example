REACT_APP_API_URL=http://localhost:3001/api
# Client ID Google (le même que GOOGLE_CLIENT_ID du backend). Vide = bouton Google masqué
REACT_APP_GOOGLE_CLIENT_ID=
# Clé publique Cloudflare Turnstile (anti-robot). Vide = case masquée.
# Clé de test (toujours valide) : 1x00000000000000000000AA
REACT_APP_TURNSTILE_SITE_KEY=
REACT_APP_NAME=Les Coccinelles
